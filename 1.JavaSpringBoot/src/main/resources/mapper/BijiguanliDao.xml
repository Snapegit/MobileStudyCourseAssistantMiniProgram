<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.BijiguanliDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.BijiguanliEntity" id="bijiguanliMap">
        <result property="bijimingcheng" column="bijimingcheng"/>
        <result property="kemu" column="kemu"/>
        <result property="tupian" column="tupian"/>
        <result property="bijixiangqing" column="bijixiangqing"/>
        <result property="shangchuanshijian" column="shangchuanshijian"/>
        <result property="xuehao" column="xuehao"/>
        <result property="xueshengxingming" column="xueshengxingming"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.BijiguanliView" >

		SELECT  bijiguanli.* FROM bijiguanli  bijiguanli 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.BijiguanliView" >
		SELECT * FROM bijiguanli  bijiguanli <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.BijiguanliView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
